# This project does not auto-load .env files. Export these variables in the
# shell, systemd, Docker Compose, or a secret manager. Never commit real values.

# FLASK_SECRET_KEY=replace-with-a-random-secret
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-password

# Local development only. Keep false on a public server.
ALLOW_DEFAULT_ADMIN=false
SESSION_COOKIE_SECURE=false

# Same-origin requests need no CORS setting. For a separate trusted frontend,
# provide an exact comma-separated allowlist (never use "*").
# CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com

# Low-resource deployment defaults (suitable for the current 2GB / 40GB host).
# Raise only after measuring the target server. Upload capacity guards reject
# new files when limits are reached; they never delete existing data.
DACHUANG_NUMERIC_THREADS=1
DACHUANG_ARCHIVE_QUOTA_MB=8192
DACHUANG_MIN_FREE_DISK_MB=2048
