# This project does not auto-load .env files. Export these variables in the
# shell, systemd, Docker Compose, or a secret manager. Never commit real values.

# FLASK_SECRET_KEY=replace-with-a-random-secret
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-strong-password

# Local development only. Keep false on a public server.
ALLOW_DEFAULT_ADMIN=false
SESSION_COOKIE_SECURE=false

# Same-origin requests need no CORS setting. For a separate trusted frontend,
# provide an exact comma-separated allowlist (never use "*").
# CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com

# Low-resource deployment defaults (suitable for the current 2GB / 40GB host).
# Raise only after measuring the target server. Upload capacity guards reject
# new files when limits are reached; they never delete existing data.
DACHUANG_NUMERIC_THREADS=1
DACHUANG_ARCHIVE_QUOTA_MB=8192
DACHUANG_MIN_FREE_DISK_MB=2048

# Optional AI second opinion. Local detection/training stays fully functional
# when these are absent or disabled. Calls occur only after a user/admin clicks
# an AI-assist button; unchanged inputs reuse the saved result.
DACHUANG_EXTERNAL_ANALYSIS_ENABLED=false
DACHUANG_EXTERNAL_ANALYSIS_USER_ENABLED=false
# DACHUANG_EXTERNAL_ANALYSIS_BASE_URL=https://provider.example/v1
# DACHUANG_EXTERNAL_ANALYSIS_API_KEY=replace-with-a-rotated-secret
DACHUANG_EXTERNAL_ANALYSIS_MODEL=gpt-5.6-sol
DACHUANG_EXTERNAL_ANALYSIS_MODE=chat_completions
DACHUANG_EXTERNAL_ANALYSIS_TIMEOUT_SECONDS=45
DACHUANG_EXTERNAL_ANALYSIS_MAX_OUTPUT_TOKENS=800
DACHUANG_EXTERNAL_ANALYSIS_CALLS_PER_HOUR=20

# The compact admin dialog can also save an API key encrypted under data/keys.
# Entering a new key there is accepted only from localhost or HTTPS. Do not
# enable DACHUANG_ALLOW_INSECURE_SECRET_CONFIG on a public server.
